# Copiá este archivo a ".env" (sin ".example") y completá con los datos
# de la conexión que tenés armada en MySQL Workbench.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=43772036
DB_NAME=brainsuplementos

# Clave interna de Flask para las sesiones. Poné cualquier texto largo al azar.
SECRET_KEY=cambia-esto-por-un-texto-largo-al-azar

# Ya no hay una sola contraseña fija: la cuenta de administrador (nombre,
# mail, usuario, contraseña y pregunta de seguridad) se crea desde la
# propia web la primera vez que entrás a /admin.

# --- Login social para clientes (opcional) ---
# Si dejás estas líneas vacías o comentadas, en /login solo aparece la opción
# de email y contraseña (funciona igual, sin nada más que configurar).
# Ver README.md, sección 7, para el paso a paso de cómo conseguir cada dato.

# Google (Google Cloud Console → Credenciales → ID de cliente OAuth 2.0)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple (Apple Developer Program, requiere cuenta paga de u$s99/año)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Recuperar contraseña por mail (opcional) ---
# Si dejás esto vacío, el link "¿Olvidaste tu contraseña?" avisa que todavía
# no está configurado, en vez de romperse. Ver README.md sección 7 para el
# paso a paso con Gmail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Cobro online con Mercado Pago (opcional) ---
# Si dejás esto vacío, "Mercado Pago" sigue apareciendo como opción de pago
# pero el pedido se avisa por WhatsApp como los otros métodos, sin romper
# nada. Ver README.md sección 9 para el paso a paso.
MP_ACCESS_TOKEN=

# Además del Access Token de arriba, esta es la clave pública (no es
# secreta, se manda al navegador) que hace falta para que el formulario de
# tarjeta aparezca integrado en la misma página en vez de redirigir a
# Mercado Pago. Se consigue en la misma pantalla que el Access Token. Ver
# README.md sección 10.1.
MP_PUBLIC_KEY=
